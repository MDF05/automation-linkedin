# PostgreSQL
POSTGRES_DB=linkedin_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (asyncpg for SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/linkedin_bot

# ADB
ADB_TIMEOUT=30

# AI Provider API Keys
DEEPSEEK_API_KEY=
GROQ_API_KEY=
IDEOGRAM_API_KEY=

# Backend
ALLOWED_ORIGINS=http://localhost:3000
SCREENSHOTS_DIR=/app/static/screenshots

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
